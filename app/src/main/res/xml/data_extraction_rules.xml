<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="arete.db" />
        <include domain="database" path="arete.db-wal" />
        <include domain="database" path="arete.db-shm" />
        <include domain="database" path="arete.db-journal" />
        <include domain="file" path="datastore/preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="arete.db" />
        <include domain="database" path="arete.db-wal" />
        <include domain="database" path="arete.db-shm" />
        <include domain="database" path="arete.db-journal" />
        <include domain="file" path="datastore/preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
